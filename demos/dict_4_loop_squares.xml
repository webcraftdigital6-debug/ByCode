<?xml version="1.0" encoding="UTF-8"?>
<!--
  Пример 4. Один блок «установить» внутри цикла добавляет много пар.

  Ключ — номер i, значение — i * i. За пять виток в словаре появляется
  пять пар: {1: 1, 2: 4, 3: 9, 4: 16, 5: 25}. Ключом может быть и число,
  не только текст.
-->
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="sq">sq</variable>
    <variable id="i">i</variable>
  </variables>
  <block type="variables_set" x="40" y="40">
    <field name="VAR" id="sq">sq</field>
    <value name="VALUE">
      <block type="dict_create"></block>
    </value>
    <next>
      <block type="controls_for">
        <field name="VAR" id="i">i</field>
        <value name="FROM">
          <shadow type="math_number"><field name="NUM">1</field></shadow>
        </value>
        <value name="TO">
          <shadow type="math_number"><field name="NUM">5</field></shadow>
        </value>
        <value name="BY">
          <shadow type="math_number"><field name="NUM">1</field></shadow>
        </value>
        <statement name="DO">
          <block type="dict_set">
            <value name="DICT">
              <block type="variables_get">
                <field name="VAR" id="sq">sq</field>
              </block>
            </value>
            <value name="KEY">
              <block type="variables_get">
                <field name="VAR" id="i">i</field>
              </block>
            </value>
            <value name="VALUE">
              <block type="math_arithmetic">
                <field name="OP">MULTIPLY</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR" id="i">i</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get">
                    <field name="VAR" id="i">i</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </statement>
        <next>
          <block type="add_text">
            <value name="TEXT">
              <block type="text_join">
                <mutation items="2"></mutation>
                <value name="ADD0">
                  <shadow type="text"><field name="TEXT">3 * 3 = </field></shadow>
                </value>
                <value name="ADD1">
                  <block type="dict_get">
                    <value name="DICT">
                      <block type="variables_get">
                        <field name="VAR" id="sq">sq</field>
                      </block>
                    </value>
                    <value name="KEY">
                      <shadow type="text"><field name="TEXT">3</field></shadow>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="add_text">
                <value name="TEXT">
                  <block type="text_join">
                    <mutation items="2"></mutation>
                    <value name="ADD0">
                      <shadow type="text"><field name="TEXT">5 * 5 = </field></shadow>
                    </value>
                    <value name="ADD1">
                      <block type="dict_get">
                        <value name="DICT">
                          <block type="variables_get">
                            <field name="VAR" id="sq">sq</field>
                          </block>
                        </value>
                        <value name="KEY">
                          <shadow type="text"><field name="TEXT">5</field></shadow>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
