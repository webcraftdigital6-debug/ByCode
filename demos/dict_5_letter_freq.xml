<?xml version="1.0" encoding="UTF-8"?>
<!--
  Пример 5. Частоты букв — как в задаче A4, но через словарь.

  Одна и та же пара «установить» выполняется каждый виток со своим ключом,
  и словарь растёт сам. Хитрость: у новой буквы считать пока нечего, поэтому
  «есть ключ?» делит ветку на «прибавить 1» и «записать первую пару».

  Слово латиницей не случайно: блоки «длина» и «взять букву №» на Lua и PHP
  считают байты, поэтому кириллица даёт вдвое больше шагов цикла. На JavaScript
  и Python слово можно поменять прямо в блоке.
-->
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="word">word</variable>
    <variable id="freq">freq</variable>
    <variable id="i">i</variable>
    <variable id="letter">letter</variable>
  </variables>
  <block type="variables_set" x="40" y="40">
    <field name="VAR" id="word">word</field>
    <value name="VALUE">
      <shadow type="text"><field name="TEXT">mama</field></shadow>
    </value>
    <next>
      <block type="variables_set">
        <field name="VAR" id="freq">freq</field>
        <value name="VALUE">
          <block type="dict_create"></block>
        </value>
        <next>
          <block type="controls_for">
            <field name="VAR" id="i">i</field>
            <value name="FROM">
              <shadow type="math_number"><field name="NUM">1</field></shadow>
            </value>
            <value name="TO">
              <block type="text_length">
                <value name="VALUE">
                  <block type="variables_get">
                    <field name="VAR" id="word">word</field>
                  </block>
                </value>
              </block>
            </value>
            <value name="BY">
              <shadow type="math_number"><field name="NUM">1</field></shadow>
            </value>
            <statement name="DO">
              <block type="variables_set">
                <field name="VAR" id="letter">letter</field>
                <value name="VALUE">
                  <block type="text_charAt">
                    <mutation at="true"></mutation>
                    <field name="WHERE">FROM_START</field>
                    <value name="VALUE">
                      <block type="variables_get">
                        <field name="VAR" id="word">word</field>
                      </block>
                    </value>
                    <value name="AT">
                      <block type="variables_get">
                        <field name="VAR" id="i">i</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="controls_if">
                    <mutation else="1"></mutation>
                    <value name="IF0">
                      <block type="dict_has_key">
                        <value name="KEY">
                          <block type="variables_get">
                            <field name="VAR" id="letter">letter</field>
                          </block>
                        </value>
                        <value name="DICT">
                          <block type="variables_get">
                            <field name="VAR" id="freq">freq</field>
                          </block>
                        </value>
                      </block>
                    </value>
                    <statement name="DO0">
                      <block type="dict_set">
                        <value name="DICT">
                          <block type="variables_get">
                            <field name="VAR" id="freq">freq</field>
                          </block>
                        </value>
                        <value name="KEY">
                          <block type="variables_get">
                            <field name="VAR" id="letter">letter</field>
                          </block>
                        </value>
                        <value name="VALUE">
                          <block type="math_arithmetic">
                            <field name="OP">ADD</field>
                            <value name="A">
                              <block type="dict_get">
                                <value name="DICT">
                                  <block type="variables_get">
                                    <field name="VAR" id="freq">freq</field>
                                  </block>
                                </value>
                                <value name="KEY">
                                  <block type="variables_get">
                                    <field name="VAR" id="letter">letter</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <shadow type="math_number"><field name="NUM">1</field></shadow>
                            </value>
                          </block>
                        </value>
                      </block>
                    </statement>
                    <statement name="ELSE">
                      <block type="dict_set">
                        <value name="DICT">
                          <block type="variables_get">
                            <field name="VAR" id="freq">freq</field>
                          </block>
                        </value>
                        <value name="KEY">
                          <block type="variables_get">
                            <field name="VAR" id="letter">letter</field>
                          </block>
                        </value>
                        <value name="VALUE">
                          <shadow type="math_number"><field name="NUM">1</field></shadow>
                        </value>
                      </block>
                    </statement>
                  </block>
                </next>
              </block>
            </statement>
            <next>
              <block type="add_text">
                <value name="TEXT">
                  <block type="text_join">
                    <mutation items="2"></mutation>
                    <value name="ADD0">
                      <shadow type="text"><field name="TEXT">m: </field></shadow>
                    </value>
                    <value name="ADD1">
                      <block type="dict_get">
                        <value name="DICT">
                          <block type="variables_get">
                            <field name="VAR" id="freq">freq</field>
                          </block>
                        </value>
                        <value name="KEY">
                          <shadow type="text"><field name="TEXT">m</field></shadow>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="add_text">
                    <value name="TEXT">
                      <block type="text_join">
                        <mutation items="2"></mutation>
                        <value name="ADD0">
                          <shadow type="text"><field name="TEXT">a: </field></shadow>
                        </value>
                        <value name="ADD1">
                          <block type="dict_get">
                            <value name="DICT">
                              <block type="variables_get">
                                <field name="VAR" id="freq">freq</field>
                              </block>
                            </value>
                            <value name="KEY">
                              <shadow type="text"><field name="TEXT">a</field></shadow>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
