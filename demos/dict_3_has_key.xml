<?xml version="1.0" encoding="UTF-8"?>
<!--
  Пример 3. «Есть ключ?» спасает от ошибки чтения.

  Чтение несуществующего ключа: JavaScript даёт undefined, Lua — nil,
  а Python показывает длинную ошибку (KeyError). Поэтому сначала спрашиваем
  блоком «Словарь: есть ключ?» и только потом читаем.
  Плюсик на блоке «если» добавляет ветку «иначе».
-->
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="marks">marks</variable>
  </variables>
  <block type="variables_set" x="40" y="40">
    <field name="VAR" id="marks">marks</field>
    <value name="VALUE">
      <block type="dict_create"></block>
    </value>
    <next>
      <block type="dict_set">
        <value name="DICT">
          <block type="variables_get">
            <field name="VAR" id="marks">marks</field>
          </block>
        </value>
        <value name="KEY">
          <shadow type="text"><field name="TEXT">Аня</field></shadow>
        </value>
        <value name="VALUE">
          <shadow type="math_number"><field name="NUM">5</field></shadow>
        </value>
        <next>
          <block type="controls_if">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="dict_has_key">
                <value name="KEY">
                  <shadow type="text"><field name="TEXT">Аня</field></shadow>
                </value>
                <value name="DICT">
                  <block type="variables_get">
                    <field name="VAR" id="marks">marks</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="add_text">
                <value name="TEXT">
                  <block type="text_join">
                    <mutation items="3"></mutation>
                    <value name="ADD0">
                      <shadow type="text"><field name="TEXT">Аня: </field></shadow>
                    </value>
                    <value name="ADD1">
                      <block type="dict_get">
                        <value name="DICT">
                          <block type="variables_get">
                            <field name="VAR" id="marks">marks</field>
                          </block>
                        </value>
                        <value name="KEY">
                          <shadow type="text"><field name="TEXT">Аня</field></shadow>
                        </value>
                      </block>
                    </value>
                    <value name="ADD2">
                      <shadow type="text"><field name="TEXT"> — оценка найдена</field></shadow>
                    </value>
                  </block>
                </value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="add_text">
                <value name="TEXT">
                  <shadow type="text"><field name="TEXT">Ани в журнале нет</field></shadow>
                </value>
              </block>
            </statement>
            <next>
              <block type="controls_if">
                <mutation else="1"></mutation>
                <value name="IF0">
                  <block type="dict_has_key">
                    <value name="KEY">
                      <shadow type="text"><field name="TEXT">Петя</field></shadow>
                    </value>
                    <value name="DICT">
                      <block type="variables_get">
                        <field name="VAR" id="marks">marks</field>
                      </block>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="add_text">
                    <value name="TEXT">
                      <shadow type="text"><field name="TEXT">Петя: </field></shadow>
                    </value>
                  </block>
                </statement>
                <statement name="ELSE">
                  <block type="add_text">
                    <value name="TEXT">
                      <shadow type="text"><field name="TEXT">Пети в журнале нет</field></shadow>
                    </value>
                  </block>
                </statement>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
