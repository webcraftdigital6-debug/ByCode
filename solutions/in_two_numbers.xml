<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <!--
    Задача 21 (in_two_numbers): оба числа читаются блоком «Ввод числа»,
    поэтому «+ − × ÷» складывает числа, а не склеивает строки.
    Вывод при ответах 3 и 4: > 3 / > 4 / 7
  -->
  <variables>
    <variable id="in-a">a</variable>
    <variable id="in-b">b</variable>
  </variables>
  <block type="variables_set" x="40" y="40">
    <field name="VAR" id="in-a">a</field>
    <value name="VALUE">
      <block type="py_input_number"></block>
    </value>
    <next>
      <block type="variables_set">
        <field name="VAR" id="in-b">b</field>
        <value name="VALUE">
          <block type="py_input_number"></block>
        </value>
        <next>
          <block type="add_text">
            <value name="TEXT">
              <block type="math_arithmetic">
                <field name="OP">ADD</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR" id="in-a">a</field>
                  </block>
                </value>
                <value name="B">
                  <block type="variables_get">
                    <field name="VAR" id="in-b">b</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
