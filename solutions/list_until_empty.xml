<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <!--
    Задача 33 (list_until_empty): «повторять, пока не» + «… пуст».
    «взять и удалить первый» печатает предмет и укорачивает список,
    поэтому цикл заканчивается ровно тогда, когда инструментов не осталось.
    Ожидаемый вывод: hammer, saw, chisel
  -->
  <variables>
    <variable id="var_tools">tools</variable>
  </variables>
  <block type="variables_set" x="40" y="40">
    <field name="VAR" id="var_tools">tools</field>
    <value name="VALUE">
      <block type="lists_create_with">
        <mutation items="3"></mutation>
        <value name="ADD0">
          <shadow type="text">
            <field name="TEXT">hammer</field>
          </shadow>
        </value>
        <value name="ADD1">
          <shadow type="text">
            <field name="TEXT">saw</field>
          </shadow>
        </value>
        <value name="ADD2">
          <shadow type="text">
            <field name="TEXT">chisel</field>
          </shadow>
        </value>
      </block>
    </value>
    <next>
      <block type="controls_whileUntil">
        <field name="MODE">UNTIL</field>
        <value name="BOOL">
          <block type="lists_isEmpty">
            <value name="VALUE">
              <block type="variables_get">
                <field name="VAR" id="var_tools">tools</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO">
          <block type="add_text">
            <value name="TEXT">
              <block type="lists_getIndex">
                <field name="MODE">GET_REMOVE</field>
                <field name="WHERE">FIRST</field>
                <value name="VALUE">
                  <block type="variables_get">
                    <field name="VAR" id="var_tools">tools</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </statement>
      </block>
    </next>
  </block>
</xml>
