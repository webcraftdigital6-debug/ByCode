<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <!--
    Задача 29 (list_inventory_replace): замена первого элемента по индексу.
    Блок lists_setIndex в режиме SET переписывает ячейку и не меняет длину.
    Ожидаемый вывод: 2, steel sword, wooden shield
  -->
  <variables>
    <variable id="var_inventory">inventory</variable>
  </variables>
  <block type="variables_set" x="40" y="40">
    <field name="VAR" id="var_inventory">inventory</field>
    <value name="VALUE">
      <block type="lists_create_with">
        <mutation items="2"></mutation>
        <value name="ADD0">
          <shadow type="text">
            <field name="TEXT">rusty dagger</field>
          </shadow>
        </value>
        <value name="ADD1">
          <shadow type="text">
            <field name="TEXT">wooden shield</field>
          </shadow>
        </value>
      </block>
    </value>
    <next>
      <block type="lists_setIndex">
        <field name="MODE">SET</field>
        <field name="WHERE">FROM_START</field>
        <value name="LIST">
          <block type="variables_get">
            <field name="VAR" id="var_inventory">inventory</field>
          </block>
        </value>
        <value name="AT">
          <shadow type="math_number">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="TO">
          <shadow type="text">
            <field name="TEXT">steel sword</field>
          </shadow>
        </value>
        <next>
          <block type="add_text">
            <value name="TEXT">
              <block type="lists_length">
                <value name="VALUE">
                  <block type="variables_get">
                    <field name="VAR" id="var_inventory">inventory</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="add_text">
                <value name="TEXT">
                  <block type="lists_getIndex">
                    <field name="MODE">GET</field>
                    <field name="WHERE">FROM_START</field>
                    <value name="VALUE">
                      <block type="variables_get">
                        <field name="VAR" id="var_inventory">inventory</field>
                      </block>
                    </value>
                    <value name="AT">
                      <shadow type="math_number">
                        <field name="NUM">1</field>
                      </shadow>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="add_text">
                    <value name="TEXT">
                      <block type="lists_getIndex">
                        <field name="MODE">GET</field>
                        <field name="WHERE">FROM_START</field>
                        <value name="VALUE">
                          <block type="variables_get">
                            <field name="VAR" id="var_inventory">inventory</field>
                          </block>
                        </value>
                        <value name="AT">
                          <shadow type="math_number">
                            <field name="NUM">2</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
