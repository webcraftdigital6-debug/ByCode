<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <!--
    Задача 42 (list_grid): поле 3×3 как список списков.
    Каждая строка напечатана двойным обращением: внешний «взять № строки»
    берёт строку из grid, внутренний «взять № элемента» — ячейку из строки.
    Ожидаемый вывод: E, C, G
  -->
  <variables>
    <variable id="var_grid">grid</variable>
  </variables>
  <block type="variables_set" x="40" y="40">
    <field name="VAR" id="var_grid">grid</field>
    <value name="VALUE">
      <block type="lists_create_with">
        <mutation items="3"></mutation>
        <value name="ADD0">
          <block type="lists_create_with">
            <mutation items="3"></mutation>
            <value name="ADD0">
              <shadow type="text">
                <field name="TEXT">A</field>
              </shadow>
            </value>
            <value name="ADD1">
              <shadow type="text">
                <field name="TEXT">B</field>
              </shadow>
            </value>
            <value name="ADD2">
              <shadow type="text">
                <field name="TEXT">C</field>
              </shadow>
            </value>
          </block>
        </value>
        <value name="ADD1">
          <block type="lists_create_with">
            <mutation items="3"></mutation>
            <value name="ADD0">
              <shadow type="text">
                <field name="TEXT">D</field>
              </shadow>
            </value>
            <value name="ADD1">
              <shadow type="text">
                <field name="TEXT">E</field>
              </shadow>
            </value>
            <value name="ADD2">
              <shadow type="text">
                <field name="TEXT">F</field>
              </shadow>
            </value>
          </block>
        </value>
        <value name="ADD2">
          <block type="lists_create_with">
            <mutation items="3"></mutation>
            <value name="ADD0">
              <shadow type="text">
                <field name="TEXT">G</field>
              </shadow>
            </value>
            <value name="ADD1">
              <shadow type="text">
                <field name="TEXT">H</field>
              </shadow>
            </value>
            <value name="ADD2">
              <shadow type="text">
                <field name="TEXT">I</field>
              </shadow>
            </value>
          </block>
        </value>
      </block>
    </value>
    <next>
      <block type="add_text">
        <value name="TEXT">
          <block type="lists_getIndex">
            <field name="MODE">GET</field>
            <field name="WHERE">FROM_START</field>
            <value name="VALUE">
              <block type="lists_getIndex">
                <field name="MODE">GET</field>
                <field name="WHERE">FROM_START</field>
                <value name="VALUE">
                  <block type="variables_get">
                    <field name="VAR" id="var_grid">grid</field>
                  </block>
                </value>
                <value name="AT">
                  <shadow type="math_number">
                    <field name="NUM">2</field>
                  </shadow>
                </value>
              </block>
            </value>
            <value name="AT">
              <shadow type="math_number">
                <field name="NUM">2</field>
              </shadow>
            </value>
          </block>
        </value>
        <next>
          <block type="add_text">
            <value name="TEXT">
              <block type="lists_getIndex">
                <field name="MODE">GET</field>
                <field name="WHERE">FROM_START</field>
                <value name="VALUE">
                  <block type="lists_getIndex">
                    <field name="MODE">GET</field>
                    <field name="WHERE">FROM_START</field>
                    <value name="VALUE">
                      <block type="variables_get">
                        <field name="VAR" id="var_grid">grid</field>
                      </block>
                    </value>
                    <value name="AT">
                      <shadow type="math_number">
                        <field name="NUM">1</field>
                      </shadow>
                    </value>
                  </block>
                </value>
                <value name="AT">
                  <shadow type="math_number">
                    <field name="NUM">3</field>
                  </shadow>
                </value>
              </block>
            </value>
            <next>
              <block type="add_text">
                <value name="TEXT">
                  <block type="lists_getIndex">
                    <field name="MODE">GET</field>
                    <field name="WHERE">FROM_START</field>
                    <value name="VALUE">
                      <block type="lists_getIndex">
                        <field name="MODE">GET</field>
                        <field name="WHERE">FROM_START</field>
                        <value name="VALUE">
                          <block type="variables_get">
                            <field name="VAR" id="var_grid">grid</field>
                          </block>
                        </value>
                        <value name="AT">
                          <shadow type="math_number">
                            <field name="NUM">3</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                    <value name="AT">
                      <shadow type="math_number">
                        <field name="NUM">1</field>
                      </shadow>
                    </value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
