<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <!--
    Задача 50 (str_echo): эхо собирается дописыванием внутри цикла.
   cry = ROAR, echo стартует пустым, три шага приклеивают "ROAR!".
    Ожидаемый вывод: R, ROAR!ROAR!ROAR!
  -->
  <variables>
    <variable id="var_cry">cry</variable>
    <variable id="var_echo">echo</variable>
  </variables>
  <block type="variables_set" x="40" y="40">
    <field name="VAR" id="var_cry">cry</field>
    <value name="VALUE">
      <shadow type="text">
        <field name="TEXT">ROAR</field>
      </shadow>
    </value>
    <next>
      <block type="variables_set">
        <field name="VAR" id="var_echo">echo</field>
        <value name="VALUE">
          <shadow type="text">
            <field name="TEXT"></field>
          </shadow>
        </value>
        <next>
          <block type="controls_repeat_ext">
            <value name="TIMES">
              <shadow type="math_number">
                <field name="NUM">3</field>
              </shadow>
            </value>
            <statement name="DO">
              <block type="text_append">
                <field name="VAR" id="var_echo">echo</field>
                <value name="TEXT">
                  <block type="text_join">
                    <mutation items="2"></mutation>
                    <value name="ADD0">
                      <block type="variables_get">
                        <field name="VAR" id="var_cry">cry</field>
                      </block>
                    </value>
                    <value name="ADD1">
                      <shadow type="text">
                        <field name="TEXT">!</field>
                      </shadow>
                    </value>
                  </block>
                </value>
              </block>
            </statement>
            <next>
              <block type="add_text">
                <value name="TEXT">
                  <block type="text_charAt">
                    <field name="WHERE">FIRST</field>
                    <value name="VALUE">
                      <block type="variables_get">
                        <field name="VAR" id="var_cry">cry</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="add_text">
                    <value name="TEXT">
                      <block type="variables_get">
                        <field name="VAR" id="var_echo">echo</field>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
