{
  "name": "bycode",
  "version": "1.0.0",
  "description": "ByCode — browser-based visual programming learning app (Google Blockly)",
  "scripts": {
    "build": "npm install --prefix app && cd app && npm run build",
    "start": "node server/index.js",
    "test": "cd app && npm test",
    "lint": "cd app && npm run lint",
    "typecheck": "cd app && npm run typecheck",
    "server": "node server/index.js",
    "promo": "node scripts/promo.js",
    "test:server": "cd server && npx vitest run",
    "dev": "powershell -Command \"Start-Process -NoNewWindow npm -ArgumentList 'run server'; Start-Process -NoNewWindow npm -ArgumentList 'start:app'",
    "start:app": "cd app && npm start",
    "pdf": "node scripts/create-pdf.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "blockly": "12.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.13.0"
  },
  "overrides": {
    "body-parser": "^2.2.1"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
