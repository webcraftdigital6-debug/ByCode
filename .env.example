# Пример переменных окружения контейнера.
#
# Локально: cp .env.example .env и заполнить нужное (.env в git не попадает).
# В Dokploy: эти же пары ключ=значение — во вкладку Environment сервиса;
# Dokploy сам положит их в .env рядом с compose-файлом.
#
# NODE_ENV, HOST, PORT и DATA_DIR уже заданы в docker-compose.yml и в Dockerfile —
# дублировать их не нужно, а DATA_DIR лучше не трогать: это путь тома с базой.

# Куда приходить обратная связь. Без SMTP письма не уходят, фидбэк копится в
# DATA_DIR/feedback.json (эндпоинты админ-выгрузки читают тот же файл).
FEEDBACK_TO=you@example.com

# Реальная отправка писем (Nodemailer). Без этих переменных сервер работает с
# файловым фолбэком и печатает предупреждение в лог.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Публичный адрес сервиса без завершающего слеша. Нужен платёжным callback-URL:
# Robokassa ResultURL = https://<домен>/api/billing/result/robokassa.
# Этот же адрес указывать в кабинетах OAuth как redirect URI.
APP_BASE_URL=https://app.example.com

# ---------- Монетизация ----------
# none | robokassa | mock (mock только для разработки)
BILLING_PROVIDER=none
BILLING_PRICE_RUB=490
BILLING_DAYS=30
BILLING_CURRENCY=RUB
BILLING_PRODUCT_LABEL=
# Промокоды (npm run promo). В прода по умолчанию выключены.
BILLING_PROMO_ENABLED=0
# Требовать подтверждение счёта у провайдера после ResultURL.
BILLING_REQUIRE_CONFIRM=0

# Робочий кабинет Robokassa (для BILLING_PROVIDER=robokassa)
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_MODE=1
ROBOKASSA_CHECKOUT_URL=
ROBOKASSA_API_URL=
ROBOKASSA_CONFIRM_URL=

# Тестовый провайдер (BILLING_PROVIDER=mock)
MOCK_MERCHANT_LOGIN=
MOCK_NOTIFICATION_SECRET=

# ---------- Вход по OAuth (необязательно, пусто = кнопка скрыта) ----------
# В кабинетах провайдеров redirect URI должен указывать на APP_BASE_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
